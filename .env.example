# Azure OpenAI 配置（必填）
AZURE_OPENAI_KEY=your-api-key
AZURE_OPENAI_ENDPOINT=https://your-gateway.example.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# MSAL Public Client ID（可选，有默认值）
# MSAL_CLIENT_ID=d999b252-3977-4eae-bdae-a0f58c5336b7

# 持久化目录（App Service 设为 /home/poe-data/，本地留空使用项目目录）
# PERSIST_DIR=/home/poe-data/
